{
  "name": "math-solver-app",
  "version": "1.0.0",
  "description": "AI-Powered All-in-One Mathematics Question Solver",
  "main": "index.js",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm-run-all install:backend install:frontend",
    "setup": "npm install && npm run install:all",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "clean:backend": "cd backend && rm -rf node_modules package-lock.json",
    "clean:frontend": "cd frontend && rm -rf node_modules package-lock.json",
    "clean:all": "npm-run-all clean:backend clean:frontend && rm -rf node_modules package-lock.json",
    "clean": "npm run clean:all",
    "reinstall": "npm run clean:all && npm run setup",
    "test:backend": "curl http://localhost:5000/health",
    "test": "npm run test:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint": "npm run lint:frontend"
  },
  "keywords": [
    "math",
    "solver",
    "ai",
    "education",
    "calculator",
    "step-by-step",
    "graphs",
    "calculus",
    "algebra"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/math-solver.git"
  }
}
